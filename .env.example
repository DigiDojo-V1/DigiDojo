# Copy to .env (or .env.local). Every value is optional: with FLAG_AI off (the default) the
# game doesn't mark written explanations (and hides the "In your own words" box).

# "on" = OpenAI marks written explanations. Anything else = off.
FLAG_AI=off
OPENAI_API_KEY=

# Optional model override. Default: gpt-5.4-mini
OPENAI_JUDGE_MODEL=

# Upstash Redis for rate limiting (Vercel Marketplace sets these, or KV_REST_API_URL/TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live voice calls (Authority dojo). With GEMINI_API_KEY set, players can answer calls with their
# voice: an AI plays the caller in real time, and a second model reviews the call afterwards.
# Without it, every call is played with reply options instead. VOICE_AI=off switches it off.
GEMINI_API_KEY=
VOICE_AI=
# Optional model overrides. Defaults: gemini-3.8-live (caller), gemini-3.8-flash (review)
GEMINI_LIVE_MODEL=
GEMINI_JUDGE_MODEL=
