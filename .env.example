# Copy to .env (or .env.local) for local development. Every value is optional: with
# FLAG_AI off (the default) the game uses built-in reason chips and doesn't grade notes.

# "on" = Gemini writes the reason chips and grades written explanations. Anything else = off.
FLAG_AI=off

# Gemini auth: set ONE of the three options below (see docs/DEPLOY_GEMINI.md).
# 1. Gemini API key
GEMINI_API_KEY=
# 2. Vertex AI with a service account (the whole JSON key, on one line)
GCP_SERVICE_ACCOUNT_JSON=
# 3. Vertex AI with an OAuth client: run `npm run google:auth` to fill in GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Needed for options 2 and 3
GCP_PROJECT_ID=
GCP_LOCATION=global

# Optional model overrides. Defaults: gemini-flash-lite-latest (chips), gemini-flash-latest (grading)
GEMINI_CHIPS_MODEL=
GEMINI_JUDGE_MODEL=

# Upstash Redis for rate limiting (Vercel Marketplace sets these, or KV_REST_API_URL/TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
