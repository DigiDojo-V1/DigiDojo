# Copy to .env (or .env.local). Every value is optional: with FLAG_AI off (the default) the
# game uses built-in reason chips and doesn't mark written explanations.

# "on" = OpenAI writes the reason chips and marks written explanations. Anything else = off.
FLAG_AI=off
OPENAI_API_KEY=

# Optional model overrides. Defaults: gpt-5.4-nano (chips), gpt-5.4-mini (marking)
OPENAI_CHIPS_MODEL=
OPENAI_JUDGE_MODEL=

# Upstash Redis for rate limiting (Vercel Marketplace sets these, or KV_REST_API_URL/TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
