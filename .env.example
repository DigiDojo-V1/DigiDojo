# Copy to .env.local for local development. Every value is optional: without them the
# game still works, with built-in reason chips and no grading of written explanations.

# Gemini on Vertex AI (see docs/DEPLOY_GEMINI.md)
# The whole service-account JSON key, on one line.
GCP_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=
# "global" or a region such as "asia-south1"
GCP_LOCATION=global
# Check the current model ids in Vertex AI Model Garden.
# A cheap, fast model for reason chips (Flash-Lite tier).
GEMINI_CHIPS_MODEL=
# A stronger model for grading explanations (Flash tier).
GEMINI_JUDGE_MODEL=

# Upstash Redis for rate limiting (Vercel Marketplace sets these, or KV_REST_API_URL/TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
